{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/tools/concept-graph/recall.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 ~/.claude/tools/concept-graph/cg.py:*)",
      "Bash(cg:*)"
    ]
  }
}
