#!/usr/bin/python3
"""pm: dispatch `pm ticket <verb>` and `pm view <verb>` to the component's ticket tool."""
import os
import sys

HELP = """usage: pm <family> <verb> [args...]

families:
  ticket   the ledger and its lifecycle verbs (create, show, close, ready, ...)
  view     pure renderers over the projection (board, overview)
"""

argv = sys.argv[1:]
if not argv or argv[0] in ("-h", "--help"):
    sys.stdout.write(HELP)
    sys.exit(0)
if argv[0] not in ("ticket", "view") or len(argv) < 2:
    sys.stderr.write(HELP)
    sys.exit(2)
if argv[0] == "view" and argv[1] not in ("board", "overview"):
    sys.stderr.write("pm view: usage: pm view board|overview [args...]\n")
    sys.exit(2)

component = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
tool = os.path.join(component, "tools", "ticket")
os.execv("/usr/bin/python3", ["/usr/bin/python3", tool, *argv[1:]])
