#!/usr/bin/python3
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pilot

if "pilot" not in os.environ.get("PM_LABELS", "").split():
    sys.exit(0)
tid = os.environ["PM_ID"]
notes = []
for t in pilot.open_pilots():
    if t["id"] == tid:
        notes = t["notes"]


def has_note(prefix):
    return any((n.get("text") or "").startswith(prefix) for n in notes)


if not (has_note("measured:") and has_note("ruling:")):
    print('pilot: %s needs a note starting "measured:" and one starting "ruling:" before it is done.' % tid)
    sys.exit(1)
