{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm-spec/v2/ticket.schema.json",
  "title": "one row of .pm/tickets.jsonl (spec v2)",
  "$comment": "v2 delta from pm-spec/v1/ticket.schema.json: assignee narrowed to agent:/human:/legacy: shapes; edges[].to widened to accept an optional cross-store <prefix>/ segment; closure_reason added as a 14th key. Cross-row rules (id uniqueness, edge targets, parent kind, cycles, prefix match) are invariants, not schema, same as v1.",
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,7}-[0-9a-f]{6,11}$" },
    "edge_target": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9]{1,7}/)?[a-z][a-z0-9]{1,7}-[0-9a-f]{6,11}$",
      "$comment": "bare = local id (same as v1 $defs/id); <prefix>/<id> = cross-store (ADR Q6)"
    },
    "assignee": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^agent:[a-z][a-z0-9_-]*/[A-Za-z0-9._-]+#[0-9a-f]{8}$" },
        { "type": "string", "pattern": "^human:[A-Za-z0-9._-]+$" },
        { "type": "string", "pattern": "^legacy:.+$", "$comment": "migration-only landing spot; never written by a v2-aware create/claim" }
      ]
    },
    "label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_./-]*$", "maxLength": 80 },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "to"],
      "properties": {
        "type": { "enum": ["blocks", "related", "discovered-from", "blocked-by"] },
        "to": { "$ref": "#/$defs/edge_target" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ts", "text"],
      "properties": {
        "ts": { "$ref": "#/$defs/timestamp" },
        "text": { "type": "string" },
        "kind": { "enum": ["worker-return", "park", "finding", "decision", "edit-trail", "provenance", "measurement"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["assignee", "body", "closure_reason", "created", "edges", "id", "kind", "labels", "notes", "parent", "priority", "status", "title", "updated"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\n\\r]*$" },
    "body": { "type": "string" },
    "kind": { "enum": ["task", "epic"] },
    "status": { "enum": ["open", "claimed", "done-unmerged", "closed"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 4 },
    "assignee": { "$ref": "#/$defs/assignee" },
    "parent": { "anyOf": [ { "$ref": "#/$defs/id" }, { "type": "null" } ] },
    "labels": { "type": "array", "items": { "$ref": "#/$defs/label" }, "uniqueItems": true },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "created": { "$ref": "#/$defs/timestamp" },
    "updated": { "$ref": "#/$defs/timestamp" },
    "closure_reason": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["done", "wont-fix", "duplicate", "superseded", "abandoned"] }
      ]
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "reason", "since"],
      "properties": {
        "token": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "reason": { "type": "string", "minLength": 1 },
        "since": { "$ref": "#/$defs/timestamp" }
      },
      "$comment": "optional 15th key (fr-d088b2): present only on a claimed row whose session declared it in flight; absent otherwise"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "anyOf": [ { "enum": ["none"] }, { "$ref": "#/$defs/id" } ] },
      "$comment": "optional key (fr-05e45a): written by close --findings; absent = not attested"
    },
    "dedupe_overridden": {
      "const": true,
      "$comment": "optional key (fr-1bdf6d): written by create --new, the duplicate-guard override; absent otherwise"
    },
    "findings_absent": {
      "const": true,
      "$comment": "optional key (fr-7e1d26): written by a close without --findings while findings_required is off; absent otherwise, cleared by reopen"
    },
    "closed_by": {
      "type": "string",
      "pattern": "^(legacy:.+|human:[^\\s#]+|agent:[^/\\s]+/[^#\\s]+#[0-9a-f]{8})$",
      "$comment": "optional key (fr-253a2d): the claim-shaped identity of the session that ran close / close --unmerged; absent when no session token was known; cleared by reopen and release"
    },
    "released_by": {
      "type": "string",
      "pattern": "^(legacy:.+|human:[^\\s#]+|agent:[^/\\s]+/[^#\\s]+#[0-9a-f]{8})$",
      "$comment": "optional key (fr-253a2d): the claim-shaped identity of the session that ran release; absent when no session token was known; cleared by claim, close and reopen"
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "closed", "reason"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "closed": { "$ref": "#/$defs/timestamp" },
          "reason": { "anyOf": [ { "type": "string" }, { "type": "null" } ] },
          "note": { "type": "string" },
          "findings": {
            "type": "array",
            "minItems": 1,
            "items": { "anyOf": [ { "enum": ["none"] }, { "$ref": "#/$defs/id" } ] }
          },
          "closed_by": {
            "type": "string",
            "pattern": "^(legacy:.+|human:[^\\s#]+|agent:[^/\\s]+/[^#\\s]+#[0-9a-f]{8})$"
          }
        }
      },
      "$comment": "optional key (fr-44a827): legal only on kind epic; one tombstone per compacted closed child task (compact_closed_after_days), sorted by (closed, id); the id keeps resolving as a closed ticket"
    }
  }
}
