{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm-spec/v2/config.schema.json",
  "title": ".pm/config.json (spec v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "prefix", "store_id"],
  "properties": {
    "spec_version": { "type": "integer", "const": 2 },
    "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$" },
    "store_id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "history_ref": { "enum": ["pm-store"] },
    "history_interval_seconds": { "type": "integer", "minimum": 0 },
    "compact_closed_after_days": { "type": "integer", "minimum": 0 },
    "archive_closed_after_days": { "type": "integer", "minimum": 0 },
    "legacy_prefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$" }
    },
    "gate": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "findings_required": { "type": "boolean" },
    "known_red": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match", "ticket", "since"],
        "properties": {
          "match": { "type": "string", "minLength": 1 },
          "ticket": { "type": "string", "minLength": 1 },
          "since": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "created_by": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9_-]*/[A-Za-z0-9._-]+$" },
        { "type": "null" }
      ]
    }
  }
}
