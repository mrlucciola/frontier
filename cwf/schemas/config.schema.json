{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwf.local/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "cwf/v1"
    },
    "mode": {
      "enum": [
        "active",
        "advisory",
        "off"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "enum": [
          "product",
          "design",
          "docs",
          "plan",
          "build",
          "maintain"
        ]
      },
      "maxItems": 6
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8000
      },
      "maxItems": 1000
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8000
      },
      "maxItems": 1000
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1073741824
        },
        "file_bytes": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10485760
        },
        "seconds": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 120
        },
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "packet_bytes": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 32000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cache_days": {
      "type": "integer",
      "minimum": 0
    },
    "observation_days": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}
